    <PackageVersion Update="Microsoft.Extensions.Hosting.Abstractions" Version="11.0.0" />
    <PackageVersion Update="Microsoft.Extensions.Logging.Abstractions" Version="11.0.0" />
    <PackageVersion Update="Microsoft.Extensions.Options" Version="11.0.0" />
    <PackageVersion Update="Microsoft.Extensions.Primitives" Version="11.0.0" />
    <PackageVersion Update="Polly.Core" Version="8.9.1" />
    <PackageVersion Update="Polly.RateLimiting" Version="8.9.1" />
    <PackageVersion Update="System.ClientModel" Version="1.17.0" />
    <PackageVersion Update="System.Memory.Data" Version="11.0.0" />
