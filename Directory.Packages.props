    <PackageVersion Include="Boutquin.MarketData.Abstractions" Version="[3.0.0]" />
    <PackageVersion Include="Boutquin.MarketData.Calendars" Version="[3.0.0]" />
    <PackageVersion Include="Boutquin.MarketData.Storage" Version="[3.0.0]" />
    <PackageVersion Include="Boutquin.MarketData.Conventions" Version="[3.0.0]" />
    <PackageVersion Include="Boutquin.MarketData.DependencyInjection" Version="[3.0.0]" />
    <PackageVersion Include="Boutquin.MarketData.Adapter.NewYorkFed" Version="[3.0.0]" />
    <PackageVersion Include="Boutquin.MarketData.Adapter.UsTreasury" Version="[3.0.0]" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="11.0.0" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="FluentAssertions" Version="8.11.0" />
    <PackageVersion Include="FsCheck.Xunit" Version="3.6.0" />
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="11.0.100" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="NetArchTest.eNhancedEdition" Version="1.4.5" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <!-- External transitives are independently qualified. First-party archive pins
         follow the exact package packet coordinated by the owning repositories. -->
    <PackageVersion Include="FSharp.Core" Version="11.0.100" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Common" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageVersion Include="Microsoft.Diagnostics.NETCore.Client" Version="0.2.750501" />
    <PackageVersion Include="Microsoft.Diagnostics.Runtime" Version="4.2.751201" />
    <PackageVersion Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="4.0.0" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
    <!-- Known-good tooling fallback: BDN requires Perfolizer [0.6.1], and
         Pragmastat 14.0.1 removes a required constructor. All-latest exception
         remains unapproved for release; preserve the recorded failing probe. -->
    <PackageVersion Include="Perfolizer" Version="0.6.1" />
    <PackageVersion Include="Pragmastat" Version="3.2.4" />
    <PackageVersion Include="System.CodeDom" Version="10.0.14" />
    <PackageVersion Include="System.Management" Version="10.0.14" />
    <PackageVersion Include="xunit.analyzers" Version="2.3.0" />
    <PackageVersion Include="Azure.Core" Version="1.64.0" />
    <PackageVersion Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Abstractions" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.Abstractions" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.FileProviders.Abstractions" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Primitives" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Identity.Client" Version="4.92.0" />
    <PackageVersion Include="Microsoft.Identity.Client.Extensions.Msal" Version="4.92.0" />
    <PackageVersion Include="Microsoft.IdentityModel.Abstractions" Version="8.23.0" />
