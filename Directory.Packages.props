    <PackageVersion Update="Microsoft.CodeAnalysis.Analyzers" Version="5.12.0" />
    <PackageVersion Update="Microsoft.CodeAnalysis.Common" Version="5.12.0" />
    <PackageVersion Update="Microsoft.CodeAnalysis.CSharp" Version="5.12.0" />
    <PackageVersion Update="Perfolizer" Version="0.7.5" />
    <PackageVersion Update="Pragmastat" Version="14.0.1" />
    <PackageVersion Update="System.CodeDom" Version="11.0.0" />
