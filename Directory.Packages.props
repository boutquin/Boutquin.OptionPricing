    <PackageVersion Include="Polly.Core" Version="8.9.1" />
    <PackageVersion Include="Polly.RateLimiting" Version="8.9.1" />
    <PackageVersion Include="System.ClientModel" Version="1.16.0" />
    <PackageVersion Include="System.Memory.Data" Version="10.0.14" />
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="10.0.14" />
    <PackageVersion Include="System.Threading.RateLimiting" Version="11.0.0" />
    <PackageVersion Include="TestableIO.System.IO.Abstractions" Version="22.3.0" />
    <PackageVersion Include="Testably.Abstractions.FileSystem.Interface" Version="10.4.0" />
  </ItemGroup>
  <!-- Latest stable packages for the .NET 11 target, verified against NuGet.org on 2026-11-14. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
