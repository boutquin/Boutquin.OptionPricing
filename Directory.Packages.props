    <PackageVersion Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="4.0.0" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
    <!-- Known-good tooling fallback: BDN requires Perfolizer [0.6.1], and
         Pragmastat 14.0.1 removes a required constructor. All-latest exception
         remains unapproved for release; preserve the recorded failing probe. -->
    <PackageVersion Include="Perfolizer" Version="0.6.1" />
    <PackageVersion Include="Pragmastat" Version="3.2.4" />
    <PackageVersion Include="System.CodeDom" Version="10.0.14" />
